#include "Freenove_WS2812_Lib_for_ESP32.h"

// LED configuration
#define LEDS_COUNT  6
#define LEDS_PIN    33

#define JOY_X       36  
#define JOY_Y       39  

// Optional button pin (not used here)
// #define JOY_BTN     32

Freenove_ESP32_WS2812 strip = Freenove_ESP32_WS2812(LEDS_COUNT, LEDS_PIN);

void setup() {
  strip.begin();
  // If needed: pinMode(JOY_BTN, INPUT_PULLUP);
}

void loop() {
  int xVal = analogRead(JOY_X);  // 0 to 4095
  int yVal = analogRead(JOY_Y);


  uint8_t red   = map(xVal, 0, 4095, 0, 255);
  uint8_t green = map(yVal, 0, 4095, 0, 255);
  uint8_t blue  = 255 - ((red + green) / 2); 


  for (int i = 0; i < LEDS_COUNT; i++) {
    strip.setLedColorData(i, red, green, blue);
  }

  strip.show();
  delay(50);
}
